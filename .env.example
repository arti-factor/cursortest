# Google Places API (New) - erforderlich für Modus A ("Public Audit")
# Google Cloud Console -> APIs & Dienste -> "Places API (New)" aktivieren,
# Abrechnungskonto verknüpfen, Zugangsdaten -> API-Key erstellen.
# Siehe README.md, Abschnitt "Einrichtung".
GOOGLE_PLACES_API_KEY=AIzaSyBUJQIUYRuiOPV2-EFNiYvrJT7Nqd1Rpbg

# OAuth-Client für Modus B ("Full Audit", optional).
# Google Cloud Console -> APIs & Dienste -> Zugangsdaten -> OAuth-Client-ID
# (Anwendungstyp: Desktop-App). client_secret.json Pfad hier eintragen oder
# Inhalt direkt als JSON-String in GOOGLE_OAUTH_CLIENT_SECRET_JSON.
GOOGLE_OAUTH_CLIENT_SECRET_FILE=

# Basisverzeichnis für Mandantendaten (Standard: ./clients)
GBP_AUDIT_CLIENTS_DIR=
